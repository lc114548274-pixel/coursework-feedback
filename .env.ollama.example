# Copy to .env; both providers can be configured at the same time.
AI_MODE=ollama
# DeepSeek external API
API_BASE_URL=https://api.deepseek.com
API_KEY=
AI_MODEL=deepseek-flash
AI_TIMEOUT=60
# Local Ollama (no key)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ENABLED=true
OLLAMA_MODEL=coursework-qwen3:8b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=4096
